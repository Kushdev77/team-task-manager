# Copy to application.properties and set your MySQL credentials
spring.application.name=backend

spring.datasource.url=jdbc:mysql://localhost:3306/team_task_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=YOUR_MYSQL_USER
spring.datasource.password=YOUR_MYSQL_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

server.port=8080

app.jwt.secret=TeamTaskManagerSecretKeyForJWTSigningMustBeAtLeast256BitsLong123456
app.jwt.expiration-ms=86400000
